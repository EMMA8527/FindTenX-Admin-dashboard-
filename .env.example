# FindTenX Admin Dashboard — server-only secrets
# Never commit real values. Never use NEXT_PUBLIC_ for these.

# Required: JWT session signing + encryption key material for per-admin MFA secrets at rest
ADMIN_SESSION_SECRET=

# REMOVED (do not set — shared credentials are forbidden):
# ADMIN_PASSWORD_HASH=
# ADMIN_MFA_SECRET=
#
# Provision each administrator individually:
#   node scripts/generate-admin-secrets.mjs --write
#   node scripts/provision-admin.mjs --email you@findtenx.com --name "Your Name" --role super_admin

# Platform mode: core (default) | local_dev
# PLATFORM_DATA_MODE=core

# FindTenX Core (after DNS + deploy)
# FINDTENX_API_URL=https://api.findtenx.app
# FINDTENX_ADMIN_API_KEY=

# FindTenX Data (only when Data is live — leave empty otherwise)
# FINDTENX_DATA_API_URL=
# FINDTENX_DATA_API_KEY=

# Dev-only: return password-reset tokens in API responses (never in production)
# ALLOW_DEV_RESET_TOKEN=1
