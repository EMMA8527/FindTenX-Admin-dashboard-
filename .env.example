# Server-only secrets for FindTenX Admin Dashboard (this app only).
# Copy to .env.local for local development (gitignored).
# Never commit real values. Never prefix these with NEXT_PUBLIC_.
# Do not reuse these names for Mobile, Core, or Data projects.

# ── Admin authentication (required) ─────────────────────────────────────────
# Random string, at least 32 characters
ADMIN_SESSION_SECRET=

# bcrypt hash of the administrator password
# Prefer base64:<bcrypt-hash> so dotenv does not corrupt '$' characters.
# Generate with: node scripts/generate-admin-secrets.mjs --write
ADMIN_PASSWORD_HASH=

# Base32 TOTP secret for authenticator apps
ADMIN_MFA_SECRET=

# ── Platform mode ───────────────────────────────────────────────────────────
# core (default) — require FindTenX Core; refuse local SQLite as production
# local_dev — explicit non-production local SQLite only
# PLATFORM_DATA_MODE=core
# Production builds refuse local_dev unless:
# ALLOW_LOCAL_PLATFORM_DATA=true

# ── FindTenX Core (authoritative platform backend) ──────────────────────────
# Canonical production host (Mobile + Core docs): https://api.findtenx.app
# Health check: GET /api/v1/health
# DNS must resolve and Core must be deployed before this connection works.
FINDTENX_API_URL=https://api.findtenx.app

# Optional until Core exposes an admin API-key scheme.
# Current FindTenX-Core uses user JWT Bearer auth only (no ADMIN_API_KEY in Core).
# FINDTENX_ADMIN_API_KEY=

# ── FindTenX Data (analytics / reporting) — separate from Core ──────────────
# No published production hostname in findtenx-data yet.
# Do NOT copy FINDTENX_API_URL here.
# FINDTENX_DATA_API_URL=
# FINDTENX_DATA_API_KEY=
