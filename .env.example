# Server-only secrets for FindTenX Admin authentication.
# Copy to .env.local for local development (gitignored).
# Never commit real values. Never prefix these with NEXT_PUBLIC_.

# Random string, at least 32 characters (required)
ADMIN_SESSION_SECRET=

# bcrypt hash of the administrator password (required)
# Prefer base64:<bcrypt-hash> so dotenv does not corrupt '$' characters.
# Generate with: node scripts/generate-admin-secrets.mjs --write
ADMIN_PASSWORD_HASH=

# Base32 TOTP secret for authenticator apps (required)
ADMIN_MFA_SECRET=

# Optional future backend integration
# FINDTENX_API_URL=
